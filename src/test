#include <OneWire.h>
#include <DallasTemperature.h>

// ================= CONFIG =================
#define ONE_WIRE_BUS 14
#define MAX_SENSORS 3   // fixe pour ta maquette

OneWire oneWire(ONE_WIRE_BUS);
DallasTemperature sensors(&oneWire);

// ================= STRUCTS =================
typedef struct {
  int intervalle_sec;
  int nbSamples;
} ConfigData;

typedef struct {
  int sensorId;
  float temperature;
} SensorData;

typedef struct {
  int count;
  SensorData data[MAX_SENSORS];
} ResultPacket;

// ================= QUEUES =================
QueueHandle_t configQueue;
QueueHandle_t resultQueue;

// ================= MUTEX =================
SemaphoreHandle_t serialMutex;

// ================= TASK CAPTEURS =================
void taskCapteurs(void *pvParameters) {

  ConfigData config;
  ResultPacket packet;

  xQueueReceive(configQueue, &config, portMAX_DELAY);

  for (int s = 0; s < config.nbSamples; s++) {

    packet.count = 0;

    sensors.requestTemperatures();

    for (int i = 0; i < MAX_SENSORS; i++) {

      DeviceAddress addr;

      if (sensors.getAddress(addr, i)) {
        packet.data[packet.count].sensorId = i;
        packet.data[packet.count].temperature = sensors.getTempC(addr);
        packet.count++;
      }
    }

    xQueueSend(resultQueue, &packet, portMAX_DELAY);

    xSemaphoreTake(serialMutex, portMAX_DELAY);
    Serial.println("\n[CAPTEURS] Packet envoyé");
    xSemaphoreGive(serialMutex);

    vTaskDelay(config.intervalle_sec * 1000 / portTICK_PERIOD_MS);
  }
}

// ================= TASK SCHEDULER =================
void taskScheduler(void *pvParameters) {

  ConfigData config = {10, 5};
  ResultPacket packet;

  xQueueSend(configQueue, &config, portMAX_DELAY);

  // timeout = 2 * intervalle
  TickType_t timeout = pdMS_TO_TICKS(config.intervalle_sec * 1000 * 2);

  for (int i = 0; i < config.nbSamples; i++) {

    if (xQueueReceive(resultQueue, &packet, timeout) == pdTRUE) {

      xSemaphoreTake(serialMutex, portMAX_DELAY);

      Serial.println("\n====================");
      Serial.println(" PACKET RECEIVED ");
      Serial.println("====================");

      for (int j = 0; j < packet.count; j++) {
        Serial.print("Sensor ");
        Serial.print(packet.data[j].sensorId);
        Serial.print(" = ");
        Serial.print(packet.data[j].temperature);
        Serial.println(" °C");
      }

      Serial.println("====================\n");

      xSemaphoreGive(serialMutex);

    } else {

      xSemaphoreTake(serialMutex, portMAX_DELAY);
      Serial.println("\n[WARNING] Timeout: no packet received");
      xSemaphoreGive(serialMutex);
    }
  }
}

// ================= SETUP =================
void setup() {

  Serial.begin(115200);
  sensors.begin();

  configQueue = xQueueCreate(1, sizeof(ConfigData));
  resultQueue = xQueueCreate(1, sizeof(ResultPacket));

  serialMutex = xSemaphoreCreateMutex();

  xTaskCreate(taskCapteurs, "Capteurs", 4096, NULL, 1, NULL);
  xTaskCreate(taskScheduler, "Scheduler", 4096, NULL, 1, NULL);
}

// ================= LOOP =================
void loop() {
}





















