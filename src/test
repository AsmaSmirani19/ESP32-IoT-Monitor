          // et on réactive le bouton
          if (status === 'TERMINE') {
            clearInterval(polling);
            polling = null;
            document.getElementById('btn-lancer').disabled = false;
            document.getElementById('progress-label').textContent =
              `Terminé — ${total} mesures effectuées`;
          }
        });
    }
