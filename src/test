// ====================================================
//  HANDLER /xml — inclut maintenant le statut et la progression
//  Le JS lit Status, Done, Total pour piloter l'interface
// ====================================================
void handleXML() {
  String xml = "<?xml version='1.0'?>\n<Data>\n";

  // statut système
  String statusStr;
  switch (systemStatus) {
    case STATUS_ATTENTE:   statusStr = "ATTENTE";   break;
    case STATUS_EN_COURS:  statusStr = "EN_COURS";  break;
    case STATUS_TERMINE:   statusStr = "TERMINE";   break;
  }
  xml += "<Status>" + statusStr + "</Status>\n";
  xml += "<Done>"   + String(samplesDone)  + "</Done>\n";
  xml += "<Total>"  + String(samplesTotal) + "</Total>\n";

  // dernières températures
  if (xSemaphoreTake(packetMutex, pdMS_TO_TICKS(50)) == pdTRUE) {
    for (int i = 0; i < latestPacket.count; i++) {
      xml += "<Sensor id='" + String(latestPacket.data[i].sensorId) + "'>";
      xml += String(latestPacket.data[i].temperature, 2);
      xml += "</Sensor>\n";
    }
    xSemaphoreGive(packetMutex);
  }

  xml += "</Data>\n";
  server.send(200, "text/xml", xml);
}

// ====================================================
//  HANDLER /config
//  Reçoit interval + samples depuis la page web
//  Envoie la ConfigData dans configQueue
//  → taskCapteurs se débloque et démarre la campagne
// ====================================================
void handleConfig() {
  if (!server.hasArg("interval") || !server.hasArg("samples")) {
    server.send(400, "text/plain", "parametres manquants");
    return;
  }

  ConfigData config;
  config.intervalle_sec = max(1, server.arg("interval").toInt());
  config.nbSamples      = max(1, server.arg("samples").toInt());

  // xQueueSend avec timeout 0 :
  // si une config est déjà en attente (tâche pas encore prête)
  // on ne bloque pas le serveur
  if (xQueueSend(configQueue, &config, 0) == pdTRUE) {
    xSemaphoreTake(serialMutex, portMAX_DELAY);
    Serial.printf("[CONFIG] interval=%ds  samples=%d → envoyé\n",
                  config.intervalle_sec, config.nbSamples);
    xSemaphoreGive(serialMutex);
    server.send(200, "text/plain", "ok");
  } else {
    // mesure déjà en cours
    server.send(409, "text/plain", "mesure en cours");
  }
}

void handleRoot() {
  server.send(200, "text/html", PAGE_HTML);
}

// ====================================================
//  TASK CAPTEURS
//  Cycle de vie :
//  1. bloque sur configQueue (attend que l'utilisateur lance)
//  2. reçoit la config → met STATUS_EN_COURS
//  3. fait nbSamples mesures avec pause intervalle_sec
//  4. met STATUS_TERMINE
//  5. retourne en 1 (attend la prochaine campagne)
// ====================================================
void taskCapteurs(void *pvParameters) {

  ConfigData   config;
  ResultPacket packet;

  while (1) {

    // ---- ÉTAPE 1 : attend la config de l'utilisateur ----
    // portMAX_DELAY = bloque indéfiniment jusqu'à réception
    // la tâche ne consomme aucun CPU pendant cette attente
    systemStatus = STATUS_ATTENTE;
    samplesDone  = 0;

    xSemaphoreTake(serialMutex, portMAX_DELAY);
    Serial.println("[CAPTEURS] En attente de config...");
    xSemaphoreGive(serialMutex);

    xQueueReceive(configQueue, &config, portMAX_DELAY);

    // ---- ÉTAPE 2 : config reçue → démarre la campagne ----
    samplesTotal = config.nbSamples;
    systemStatus = STATUS_EN_COURS;

    xSemaphoreTake(serialMutex, portMAX_DELAY);
    Serial.printf("[CAPTEURS] Campagne démarrée : %d mesures × %ds\n",
                  config.nbSamples, config.intervalle_sec);
    xSemaphoreGive(serialMutex);

    // ---- ÉTAPE 3 : N mesures ----
    for (int s = 0; s < config.nbSamples; s++) {

      packet.count = 0;
      sensors.requestTemperatures();

      for (int i = 0; i < MAX_SENSORS; i++) {
        DeviceAddress addr;
        if (sensors.getAddress(addr, i)) {
          packet.data[packet.count].sensorId    = i;
          packet.data[packet.count].temperature = sensors.getTempC(addr);
          packet.count++;
        }
      }

      xQueueSend(resultQueue, &packet, portMAX_DELAY);
      samplesDone = s + 1;

      xSemaphoreTake(serialMutex, portMAX_DELAY);
      Serial.printf("[CAPTEURS] Mesure %d/%d envoyée\n",
                    samplesDone, config.nbSamples);
      xSemaphoreGive(serialMutex);

      // pause entre mesures (sauf après la dernière)
      if (s < config.nbSamples - 1) {
        vTaskDelay(pdMS_TO_TICKS(config.intervalle_sec * 1000));
      }
    }

    // ---- ÉTAPE 4 : campagne terminée ----
    systemStatus = STATUS_TERMINE;

    xSemaphoreTake(serialMutex, portMAX_DELAY);
    Serial.println("[CAPTEURS] Campagne terminée — retour en attente");
    xSemaphoreGive(serialMutex);

    // retourne en haut du while → bloque sur configQueue
  }
}

// ================= TASK SERVER =================
void taskServer(void *pvParameters) {
  ResultPacket packet;
  while (1) {
    if (xQueueReceive(resultQueue, &packet, 0) == pdTRUE) {
      xSemaphoreTake(packetMutex, portMAX_DELAY);
      latestPacket = packet;
      xSemaphoreGive(packetMutex);
    }
    server.handleClient();
    vTaskDelay(pdMS_TO_TICKS(10));
  }
}

// ================= SETUP =================
void setup() {
  Serial.begin(115200);
  sensors.begin();

  WiFi.softAP(AP_SSID, AP_PASS);
  delay(100);
  Serial.print("IP : ");
  Serial.println(WiFi.softAPIP());

  server.on("/",       handleRoot);
  server.on("/xml",    handleXML);
  server.on("/config", handleConfig);
  server.begin();

  // configQueue de taille 1 — on ne peut envoyer
  // qu'une seule config à la fois (pas de file d'attente)
  configQueue = xQueueCreate(1, sizeof(ConfigData));
  resultQueue = xQueueCreate(1, sizeof(ResultPacket));
  serialMutex = xSemaphoreCreateMutex();
  packetMutex = xSemaphoreCreateMutex();
  latestPacket.count = 0;

  xTaskCreatePinnedToCore(taskCapteurs, "Capteurs", 4096, NULL, 1, NULL, 0);
  xTaskCreatePinnedToCore(taskServer,   "Server",   8192, NULL, 2, NULL, 1);
}

void loop() {}













































