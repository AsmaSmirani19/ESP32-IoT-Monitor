      const interval = document.getElementById('inp-interval').value;
      const samples  = document.getElementById('inp-samples').value;

      // désactive le bouton pendant la mesure
      document.getElementById('btn-lancer').disabled = true;
      document.getElementById('progress-box').style.display = 'block';

      // envoie la config à l'ESP32
      fetch(`/config?interval=${interval}&samples=${samples}`)
        .then(() => {
          // démarre le polling de statut
          if (polling) clearInterval(polling);
          polling = setInterval(checkStatus, 2000);
        });
